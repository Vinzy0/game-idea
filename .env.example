# Phase 5 AI provider configuration. VITE_* values are public browser settings.
# Never put API keys or provider secrets in this file.
VITE_AI_PROVIDER=demo

# To use a trusted server-side gateway instead of the offline demo:
# VITE_AI_PROVIDER=gateway
# VITE_AI_GATEWAY_URL=/api/ai
# VITE_AI_MODEL_LABEL=server-managed-model
